[Unit]
Description=Budget private web application (budget.slcti.ca)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scharest
Group=scharest
# Absolute paths: in a system unit, %h is root's home, not the User= home.
WorkingDirectory=/home/scharest/source/budget
EnvironmentFile=/home/scharest/source/budget/.env
ExecStart=/home/scharest/source/budget/.venv/bin/python /home/scharest/source/budget
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/scharest/source/budget/data

[Install]
WantedBy=multi-user.target
