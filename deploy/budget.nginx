# /etc/nginx/sites-enabled/budget-ssl.conf: HTTPS for budget.slcti.ca.
# Port 443 belongs to the SNI router in /etc/nginx/streams-enabled/slcti.conf, which sends
# budget.slcti.ca to 127.0.0.1:8444 (www.slcti.ca -> :3000, pycharting.slcti.ca -> :8443).
# Port 80 (ACME challenges + HTTPS redirect) is handled by the shared http.conf.
server {
    listen 127.0.0.1:8444 ssl;
    http2 on;
    server_name budget.slcti.ca;

    ssl_certificate /etc/letsencrypt/live/budget.slcti.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/budget.slcti.ca/privkey.pem;

    client_max_body_size 32k;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
